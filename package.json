{
  "name": "nuxt-spec",
  "version": "0.4.0-alpha.1",
  "description": "Test-pack layer for Nuxt Applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AloisSeckar/nuxt-spec.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./nuxt.config.ts",
  "scripts": {
    "analyze": "nuxt analyze",
    "eslint": "eslint .",
    "typecheck": "nuxi typecheck",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "prepublishOnly": "node bin/_internal/prepublish-check.js",
    "preview": "nuxt preview",
    "start": "nuxt start",
    "test": "vitest run",
    "test-u": "vitest run -u",
    "test-i": "vitest"
  },
  "bin": {
    "nuxt-spec": "bin/cli.js"
  },
  "exports": {
    ".": "./nuxt.config.ts",
    "./config": {
      "types": "./config/index.d.ts",
      "import": "./config/index.mjs",
      "default": "./config/index.mjs"
    },
    "./utils": {
      "types": "./utils/index.ts",
      "import": "./utils/index.ts",
      "default": "./utils/index.ts"
    },
    "./components": {
      "import": "./app/components/index.ts",
      "default": "./app/components/index.ts"
    }
  },
  "files": [
    "app",
    "bin",
    "config",
    "modules",
    "public",
    "utils",
    "nuxt.config.ts"
  ],
  "dependencies": {
    "@nuxt/eslint": "~1.17.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/test-utils": "4.3.3",
    "@vitejs/plugin-vue": "~6.0.9",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/ui": "5.0.3",
    "@vue/test-utils": "2.5.1",
    "elrh-cosca": "0.4.1",
    "fast-png": "~8.0.0",
    "happy-dom": "~20.14.5",
    "nuxt": "4.6.0",
    "pixelmatch": "~7.2.0",
    "playwright": "~1.63.0",
    "playwright-core": "~1.63.0",
    "typescript": "~6.0.3",
    "vitest": "5.0.3",
    "vitest-browser-vue": "3.1.0",
    "vue": "~3.5.43",
    "vue-router": "~5.3.1",
    "vue-tsc": "~3.3.12"
  },
  "packageManager": "pnpm@12.9.1"
}
