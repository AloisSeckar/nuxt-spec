{
  "name": "nuxt-spec",
  "version": "0.4.1",
  "description": "Test-pack layer for Nuxt Applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AloisSeckar/nuxt-spec.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./nuxt.config.ts",
  "scripts": {
    "analyze": "nuxt analyze",
    "eslint": "eslint .",
    "typecheck": "nuxi typecheck",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "prepublishOnly": "node scripts/prepublish-check.js",
    "preview": "nuxt preview",
    "release": "node scripts/release.js",
    "start": "nuxt start",
    "test": "vitest run",
    "test-u": "vitest run -u",
    "test-c": "vitest run --coverage",
    "test-i": "vitest"
  },
  "exports": {
    ".": "./nuxt.config.ts",
    "./config": {
      "types": "./config/index.d.ts",
      "import": "./config/index.mjs",
      "default": "./config/index.mjs"
    },
    "./utils": {
      "types": "./utils/index.ts",
      "import": "./utils/index.ts",
      "default": "./utils/index.ts"
    },
    "./components": {
      "import": "./app/components/index.ts",
      "default": "./app/components/index.ts"
    }
  },
  "files": [
    "app",
    "config",
    "modules",
    "public",
    "utils",
    "nuxt.config.ts",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@nuxt/devtools": "4.1.0",
    "@nuxt/eslint": "~1.17.0",
    "@nuxt/hints": "1.1.5",
    "@nuxt/test-utils": "4.4.0",
    "@vitejs/plugin-vue": "~6.0.10",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "@vue/test-utils": "2.5.1",
    "fast-png": "~8.0.0",
    "happy-dom": "~21.0.4",
    "nuxt": "4.6.4",
    "pixelmatch": "~7.2.0",
    "playwright": "1.65.0",
    "playwright-core": "1.65.0",
    "typescript": "~6.0.3",
    "vitest": "5.1.0",
    "vitest-browser-vue": "3.1.0",
    "vue": "~3.5.45",
    "vue-router": "~5.5.0",
    "vue-tsc": "~3.3.14"
  },
  "packageManager": "pnpm@12.18.0"
}
